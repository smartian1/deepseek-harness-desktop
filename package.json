{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Electron shell that launches DeepSeek Harness (dsh web) as a Node sidecar",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json && electron-builder --win nsis --x64",
    "build:win": "tsc -p tsconfig.json && electron-builder --win nsis --x64",
    "build:mac": "tsc -p tsconfig.json && electron-builder --mac dmg --x64",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "DeepSeek Harness Desktop",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
